<Project Sdk="Microsoft.NET.Sdk">
  <!-- 新运行时与发射器的单元测试。测试框架与现有 IronScheme.Tests 一致（NUnit 4）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronScheme.Core.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IronScheme.Core\IronScheme.Core.csproj" />
    <ProjectReference Include="..\IronScheme.Emit\IronScheme.Emit.csproj" />
    <ProjectReference Include="..\IronScheme.PrimGen\IronScheme.PrimGen.csproj" />
    <ProjectReference Include="..\IronScheme.Stage0\IronScheme.Stage0.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\IronScheme.Emit\samples\*.lcil" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 测试以进程方式运行宿主与 boot 镜像：引用 Host 只为让 dotnet test 先构建它（并经 GenerateBootImage 生成 boot 镜像），不引用其程序集 -->
  <ItemGroup>
    <ProjectReference Include="..\IronScheme.Host\IronScheme.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
