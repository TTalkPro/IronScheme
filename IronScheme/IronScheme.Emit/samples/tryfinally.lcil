;; try/finally 与 try/catch（iron-019 验收样例）。块末尾的 leave / endfinally 由发射器加入。
(lcil 1
  (assembly "tryfinally" (references "IronScheme.Core"))
  (type "TF" (attrs abstract sealed)
    ;; (lambda (body after) ($try/finally (body) (after)))
    (method "Run" (attrs static) (params "IronScheme.Core.Procedure" "IronScheme.Core.Procedure") (ret "System.Object")
      (locals "System.Object")
      (body
        (try (body (ldarg 0) (callvirt "IronScheme.Core.Procedure" "Invoke0" () "System.Object") (stloc 0))
             (finally (ldarg 1) (callvirt "IronScheme.Core.Procedure" "Invoke0" () "System.Object") (pop)))
        (ldloc 0) (ret)))
    ;; 调用 thunk，捕获 InvalidOperationException 时返回其消息
    (method "Catch" (attrs static) (params "IronScheme.Core.Procedure") (ret "System.Object")
      (locals "System.Object")
      (body
        (try (body (ldarg 0) (callvirt "IronScheme.Core.Procedure" "Invoke0" () "System.Object") (stloc 0))
             (catch "System.InvalidOperationException"
               (callvirt "System.Exception" "get_Message" () "System.String") (stloc 0)))
        (ldloc 0) (ret)))))
