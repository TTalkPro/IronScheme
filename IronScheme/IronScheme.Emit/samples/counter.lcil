;; 闭包计数器：Procedure 子类，自由变量为实例字段（iron-019 验收样例）
(lcil 1
  (assembly "counter" (references "IronScheme.Core"))
  (type "Counter" (base "IronScheme.Core.Procedure") (attrs sealed)
    (field "n" "System.Object")
    (method ".ctor" (attrs ctor) (params "System.Object")
      (body
        (ldarg 0) (call "IronScheme.Core.Procedure" ".ctor" () "System.Void")
        (ldarg 0) (ldarg 1) (stfld "Counter" "n")
        (ret)))
    ;; (lambda () (set! n (+ n 1)) n)
    (method "Invoke0" (attrs override) (params) (ret "System.Object")
      (body
        (ldarg 0)
        (ldarg 0) (ldfld "Counter" "n") (unbox.any "System.Int32") (ldc.i4 1) (add) (box "System.Int32")
        (stfld "Counter" "n")
        (ldarg 0) (ldfld "Counter" "n")
        (ret))))
  (type "Make" (attrs abstract sealed)
    (method "Counter" (attrs static) (params "System.Object") (ret "IronScheme.Core.Procedure")
      (body (ldarg 0) (newobj "Counter" ("System.Object")) (ret)))))
