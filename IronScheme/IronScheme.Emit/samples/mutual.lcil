;; 相互尾递归 even?/odd?：经 Procedure 虚调用，带 tail. 前缀（iron-019 验收样例）
(lcil 1
  (assembly "mutual" (references "IronScheme.Core"))
  (type "Even" (base "IronScheme.Core.Procedure") (attrs sealed)
    (field "other" "IronScheme.Core.Procedure" public)
    (method ".ctor" (attrs ctor) (params)
      (body (ldarg 0) (call "IronScheme.Core.Procedure" ".ctor" () "System.Void") (ret)))
    (method "Invoke1" (attrs override) (params "System.Object") (ret "System.Object")
      (body
        (ldarg 1) (unbox.any "System.Int32") (brtrue more)
        (ldsfld "IronScheme.Core.RT" "True") (ret)
        (label more)
        (ldarg 0) (ldfld "Even" "other")
        (ldarg 1) (unbox.any "System.Int32") (ldc.i4 1) (sub) (box "System.Int32")
        (tail) (callvirt "IronScheme.Core.Procedure" "Invoke1" ("System.Object") "System.Object")
        (ret))))
  (type "Odd" (base "IronScheme.Core.Procedure") (attrs sealed)
    (field "other" "IronScheme.Core.Procedure" public)
    (method ".ctor" (attrs ctor) (params)
      (body (ldarg 0) (call "IronScheme.Core.Procedure" ".ctor" () "System.Void") (ret)))
    (method "Invoke1" (attrs override) (params "System.Object") (ret "System.Object")
      (body
        (ldarg 1) (unbox.any "System.Int32") (brtrue more)
        (ldsfld "IronScheme.Core.RT" "False") (ret)
        (label more)
        (ldarg 0) (ldfld "Odd" "other")
        (ldarg 1) (unbox.any "System.Int32") (ldc.i4 1) (sub) (box "System.Int32")
        (tail) (callvirt "IronScheme.Core.Procedure" "Invoke1" ("System.Object") "System.Object")
        (ret))))
  (type "Mutual" (attrs abstract sealed)
    ;; 建立 even? / odd? 并返回 even?
    (method "Make" (attrs static) (params) (ret "IronScheme.Core.Procedure")
      (locals "Even" "Odd")
      (body
        (newobj "Even" ()) (stloc 0)
        (newobj "Odd" ()) (stloc 1)
        (ldloc 0) (ldloc 1) (stfld "Even" "other")
        (ldloc 1) (ldloc 0) (stfld "Odd" "other")
        (ldloc 0) (ret)))))
