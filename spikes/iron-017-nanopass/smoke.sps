;; R6RS 冒烟测试（iron-017）：eval、syntax-case、guard、逃逸续延、哈希表、数值、format。
(import (rnrs) (rnrs eval) (ironscheme))
(write (eval '(let-values (((q r) (div-and-mod 17 5))) (list q r)) (environment '(rnrs))))
(newline)
(define-syntax my-or
  (lambda (x)
    (syntax-case x ()
      ((_) #'#f)
      ((_ e) #'e)
      ((_ e r ...) #'(let ((t e)) (if t t (my-or r ...)))))))
(write (list (my-or #f 3) (let ((t 5)) (my-or #f t))))
(newline)
(write (guard (e ((assertion-violation? e) (condition-message e))) (vector-ref (vector 1) 5)))
(newline)
(write (call/cc (lambda (k) (dynamic-wind (lambda () #f) (lambda () (k 'escaped)) (lambda () #f)))))
(newline)
(let ((ht (make-hashtable string-hash string=?)))
  (hashtable-set! ht "a" 1)
  (write (list (hashtable-ref ht "a" #f) (string->list "λx") (exact->inexact 1/3) (expt 2 100) (sqrt -4))))
(newline)
(write (format "~a-~s" 'x "y")) (newline)
