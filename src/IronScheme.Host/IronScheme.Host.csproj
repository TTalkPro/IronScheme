<Project Sdk="Microsoft.NET.Sdk">
  <!-- 新控制台宿主。设计：designs/02-runtime.md §11、07 §4 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronScheme.Host</RootNamespace>
    <AssemblyName>IronScheme.Host</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- 运行时初始化与 boot 镜像（GenerateBootImage 目标在 IronScheme.Hosting 中，镜像随引用复制到输出目录） -->
    <ProjectReference Include="..\IronScheme.Hosting\IronScheme.Hosting.csproj" />
  </ItemGroup>

  <!--
    自包含发布（iron-036，designs/07-tooling-and-embedding.md §3；由 tools/build.cs publish 设置这些属性）：
    - EmbedBootImage=true：boot 镜像作为嵌入资源 ironscheme.boot.dll（SchemeRuntime 在可执行文件旁没有镜像时使用它）；
    - IronSchemeApp=目录：compile-whole-program 的产物（*.fasl 与清单 ironscheme.app）作为嵌入资源，宿主启动后运行该应用；
      IronSchemeAppName 为可执行文件名。
    单文件发布时：已嵌入的 boot 文件不再单独发布；lib/ 作为目录留在可执行文件旁（应用发布不需要 lib/，所需的库已编译嵌入）。
  -->
  <PropertyGroup Condition="'$(IronSchemeApp)' != '' and '$(IronSchemeAppName)' != ''">
    <AssemblyName>$(IronSchemeAppName)</AssemblyName>
    <!-- 程序集名与嵌入资源不同：只有本项目用单独的中间与输出目录（不能作为命令行全局属性传入，
         否则被引用的项目也会换目录，可执行项目 Emit、stage0 在两组全局属性下各构建一次、并发写同一 apphost） -->
    <IntermediateOutputPath>obj\app-$(IronSchemeAppName)\</IntermediateOutputPath>
    <OutputPath>bin\app-$(IronSchemeAppName)\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(EmbedBootImage)' == 'true'">
    <EmbeddedResource Include="..\scheme\build\ironscheme.boot.dll" LogicalName="ironscheme.boot.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(IronSchemeApp)' != ''">
    <EmbeddedResource Include="$(IronSchemeApp)\*.fasl" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(IronSchemeApp)\ironscheme.app" LogicalName="ironscheme.app" />
  </ItemGroup>
  <Target Name="IronSchemeSingleFilePublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'$(EmbedBootImage)' == 'true' and '%(ResolvedFileToPublish.RelativePath)' == 'ironscheme.boot.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'$(IronSchemeApp)' != '' and $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('lib/'))" />
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('lib/'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
