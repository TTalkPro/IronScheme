<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lcil 发射器：库 API + 命令行 iron-emit。设计：designs/04-lcil-and-emitter.md
       不引用 IronScheme.Core 项目：运行时类型按名字解析（04 §4）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronScheme.Emit</RootNamespace>
    <AssemblyName>IronScheme.Emit</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
