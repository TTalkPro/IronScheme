;; 直接调用 System.String::ToUpper、显式调用 Interop.Call，以及由发射器决议的互操作指令（iron-019 验收样例）
(lcil 1
  (assembly "interop" (references "IronScheme.Core"))
  (type "IO" (attrs abstract sealed)
    (method "Upper" (attrs static) (params "System.Object") (ret "System.Object")
      (body (ldarg 0) (castclass "System.String") (callvirt "System.String" "ToUpper" () "System.String") (ret)))
    ;; Interop.Call(typeof(Math), "Max", null, new object[] { a, b })
    (method "MaxViaInterop" (attrs static) (params "System.Object" "System.Object") (ret "System.Object")
      (body
        (ldtoken "System.Math") (call "System.Type" "GetTypeFromHandle" ("System.RuntimeTypeHandle") "System.Type")
        (ldstr "Max") (ldnull)
        (ldc.i4 2) (newarr "System.Object")
        (dup) (ldc.i4 0) (ldarg 0) (stelem.ref)
        (dup) (ldc.i4 1) (ldarg 1) (stelem.ref)
        (call "IronScheme.Core.Interop" "Call" ("System.Type" "System.String" "System.Object" "System.Object[]") "System.Object")
        (ret)))
    ;; (clr-static-call Math Max a b)：静态决议不唯一（多个重载）→ 运行时 Interop.Call
    (method "Max" (attrs static) (params "System.Object" "System.Object") (ret "System.Object")
      (clr-namespaces "System")
      (body (ldarg 0) (ldarg 1) (clr-call "Math" "Max" #t 2) (ret)))
    ;; (clr-call String ToUpperInvariant s)：只有一个重载 → 直接 callvirt
    (method "Upper2" (attrs static) (params "System.Object") (ret "System.Object")
      (body (ldarg 0) (clr-call "String" "ToUpperInvariant" #f 0) (ret)))
    ;; (clr-call String (Substring Int32 Int32) s 1 2)：显式参数类型 → 直接调用并转换参数
    (method "Sub" (attrs static) (params "System.Object" "System.Object" "System.Object") (ret "System.Object")
      (body (ldarg 0) (ldarg 1) (ldarg 2) (clr-call "String" ("Substring" ("Int32" "Int32")) #f 2) (ret)))
    ;; (clr-prop-get #f Length s)：类型在运行时决定
    (method "Len" (attrs static) (params "System.Object") (ret "System.Object")
      (body (ldarg 0) (clr-call #f "get_Length" #f 0) (ret)))
    (method "Fields" (attrs static) (params) (ret "System.Object")
      (body (clr-field-get "Int32" "MaxValue" #t) (ret)))
    (method "NewSB" (attrs static) (params "System.Object") (ret "System.Object")
      (clr-namespaces "System.Text")
      (body (ldarg 0) (clr-new "StringBuilder" 1) (ret)))
    (method "IsString" (attrs static) (params "System.Object") (ret "System.Object")
      (body (ldarg 0) (clr-is "String") (ret)))
    (method "ToByte" (attrs static) (params "System.Object") (ret "System.Object")
      (body (ldarg 0) (clr-cast "Byte") (ret)))
    (method "IntArray" (attrs static) (params "System.Object") (ret "System.Object")
      (body (ldarg 0) (clr-new-array "Int32") (ret)))
    (method "TypeOf" (attrs static) (params) (ret "System.Object")
      (body (clr-type "Int32") (ret)))))
