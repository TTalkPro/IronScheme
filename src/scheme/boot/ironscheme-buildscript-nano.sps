;; 源码根目录：当前目录（src/scheme）
(define source-root "")

;; 输出目录（命令行第一个参数），默认 boot/
(define output-dir
  (let ((args (command-line)))
    (if (and (pair? args) (pair? (cdr args))) (cadr args) "boot")))

