;;; Phase A 构建脚本（iron-028，designs/05-bootstrap.md §3）：在 stage0 上运行，
;;; 展开 boot 源文件、nanopass 与新编译器，用新编译器编译成 stage1 boot 镜像（Lcil 与 dll）。
;;; 运行（在 src/scheme 目录下）：
;;;   dotnet ../IronScheme.Stage0/bin/Release/net10.0/stage0.dll --deterministic -I lib -I lib/nanopass-framework-scheme \
;;;     boot/boot-seed.core boot/ironscheme-buildscript-nano.sps [输出目录]
;;; 输出 <输出目录>/ironscheme.boot.lcil 与 ironscheme.boot.dll（默认输出目录 boot/）。

(import 
  (rnrs base)
  (rnrs control)
  (rnrs io simple)
  (rnrs io ports)
  (rnrs lists)
  (rnrs files)
  (rnrs programs)
  (rnrs hashtables)
  (rnrs bytevectors)
  (rnrs arithmetic flonums)
  (boot expander internal)
  (boot expander compat)
  (boot expander library-manager)
  (boot expander core)
  (ironscheme unsafe)
  (ironscheme clr internal)
  (only (ironscheme core) format)
  (only (ironscheme) time-it include import library)
  (only (ironscheme clr) clr-static-call clr-static-prop-get)
  (only (ironscheme compiler) compile-forms->lcil compile->lcil-text-from-sexpr canonical-gensyms)
  (only (ironscheme) ungensym symbol-bound?)
  (prefix (only (rnrs eval) eval environment) running:))

;; 注意：上面导入的 (boot expander …) 库在运行中系统里没有作为库安装，是从源码重新加载的副本，
;; 它的 current-primitive-locations 不是运行中系统的。运行中系统的原语位置表：
;; - 新系统（stage1 起）：展开器 main 把该参数登记在符号 current-primitive-locations 上；
;; - stage0：种子中没有这一登记，从种子文本中找到 (boot expander internal) 的该绑定的位置符号取值。
;; gensym：构建过程用非确定性 gensym（名字带本进程的时间戳，与运行中系统——上一级镜像——的名字绝不冲突），
;; 编译时由 canonical-gensyms 把常量表中本进程生成的 gensym 按首次出现顺序规范改名，产物只取决于输入（iron-030）。

(define running-primlocs
  (if (symbol-bound? 'current-primitive-locations)
      ((symbol-value 'current-primitive-locations))
      (let ((form (call-with-input-file "boot/boot-seed.core"
                    (lambda (p)
                      (let loop ()
                        (let ((x (read p)))
                          (cond
                            ((eof-object? x) (error 'running-primlocs "(boot expander internal) not found in seed"))
                            ((and (pair? x) (equal? (cadr x) '(boot expander internal))) x)
                            (else (loop)))))))))
        (let loop ((bs (caddr form)))
          (cond
            ((null? bs) (error 'running-primlocs "current-primitive-locations not found in seed"))
            ((eq? (ungensym (caar bs)) 'current-primitive-locations) ((symbol-value (cadar bs))))
            (else (loop (cdr bs))))))))

;; 名字 → 构建进程中应使用的值：
;; - 展开器各库导出的名字（syntax-dispatch 等）：取本脚本导入的源码副本（bootstrap 展开用的就是它），
;;   因为宏转换器处理的语法对象是这个副本的记录类型；
;; - 其余 boot 中由 Scheme 定义的名字：取运行中系统的值。
;; 取不到返回 (values #f #f)
(define expander-exports (make-eq-hashtable))   ; 名字 → 展开器库名（展开 boot 源文件时登记）

(define (running-value name)
  (let ((plib (hashtable-ref expander-exports name #f)))
    (if plib
        (values #t (running:eval name (running:environment plib)))
        (let ((loc (running-primlocs name)))
          (if (and loc (symbol-bound? loc))
              (values #t (symbol-value loc))
              (values #f #f))))))
  
