(define (verify-map)
  (define (f x)
    (for-each
      (lambda (x)
        (unless (assq x library-legend)
          (error 'verify "not in the libraries list" x)))
      (cdr x)))
  (for-each f identifier->library-map))

(define (make-collection)
  (let ((set '()))
    (case-lambda
      (() set)
      ((x) (set! set (cons x set))))))


(define (make-system-data subst env)
  (define who 'make-system-data)
  (let ((export-subst    (make-collection))
        (export-env      (make-collection))
        (export-primlocs (make-collection)))
    (for-each
      (lambda (x)
        (let ((name (car x)) (binding (cadr x)))
          (let ((label (gensym)))
            (export-subst (cons name label))
            (export-env   (cons label binding)))))
      expander-system-macros)
    (for-each
      (lambda (x)
        (cond
          ((macro-identifier x) (values))
          ((assq x (export-subst))
           (error who "ambiguous export" x))
          ((assq x subst) =>
           ;;; primitive defined (exported) within the compiled libraries
           (lambda (p)
             (let ((label (cdr p)))
               (cond
                 ((assq label env) =>
                  (lambda (p)
                    (let ((binding (cdr p)))
                      (case (car binding)
                        ((global)
                         (export-subst (cons x label))
                         (export-env   (cons label (cons 'core-prim x)))
                         (export-primlocs (cons x (cdr binding))))
                        (else
                         (error #f "invalid binding for identifier" p x))))))
                 (else
                  (error #f "cannot find binding" x label))))))
          (else
           ;;; core primitive with no backing definition, assumed to
           ;;; be defined in other strata of the system
           (let ((label (gensym)))
             (export-subst (cons x label))
             (export-env (cons label (cons 'core-prim x)))))))
      (map car identifier->library-map))
    (values (export-subst) (export-env) (export-primlocs))))

(define identifier->library-map-hashtable
  (let ((ht (make-eq-hashtable)))
    (for-each 
      (lambda (x)
        (hashtable-set! ht (car x) x))
      identifier->library-map)
    ht))

(define (get-export-subset key subst)
  (let f ((ls subst))
    (cond
      ((null? ls) '())
      (else
       (let ((x (car ls)))
         (let ((name (car x)))
           (cond
             ((hashtable-ref identifier->library-map-hashtable name #f)
              =>
              (lambda (q)
                (cond
                  ((memq key (cdr q))
                   (cons x (f (cdr ls))))
                  (else (f (cdr ls))))))
             (else
              ;;; not going to any library?
              (f (cdr ls))))))))))

(define (build-system-library export-subst export-env primlocs)
  (define (build-library legend-entry)
    (let ((key (car legend-entry))
          (name (cadr legend-entry))
          (visible? (caddr legend-entry)))
      (let ((id     (gensym))
            (name       name)
            (version     (if (eq? (car name) 'rnrs) '(6) '()))
            (import-libs '())
            (visit-libs  '())
            (invoke-libs '()))
        (let-values (((subst env)
                      (if (equal? name '(boot system all))
                          (values export-subst export-env)
                          (values
                            (get-export-subset key export-subst)
                            '()))))
          `(install-library
             ',id ',name ',version ',import-libs ',visit-libs ',invoke-libs
             ',subst ',env values values '#f '#f  '#f '() ',visible? '#f)))))
  (let ((code `(library (boot primlocs)
                  (export) ;;; must be empty
                  (import
                    (only (boot expander library-manager)
                          install-library)
                    (only (boot expander internal)
                          current-primitive-locations)
                    (rnrs hashtables)
                    (rnrs base))
                  (current-primitive-locations
                    (let ((ht (make-eq-hashtable)))
                      ;; 纯 Scheme 建表，不依赖运行时的 C# 方法
                      (for-each (lambda (p) (hashtable-set! ht (car p) (cdr p))) ',primlocs)
                      (lambda (x)
                        (hashtable-ref ht x #f))))
                  ,@(map build-library library-legend))))
    (let-values (((name code empty-subst empty-env)
                  (boot-library-expand code)))
       code)))

(define (make-init-code)
  (values '() '() '()))

(define (expand-all files)
  ;;; remove all re-exported identifiers (those with labels in
  ;;; subst but not binding in env).
  (define (prune-subst subst env)
    (cond
      ((null? subst) '())
      ((not (assq (cdar subst) env)) (prune-subst (cdr subst) env))
      (else (cons (car subst) (prune-subst (cdr subst) env)))))
  (define (load file proc)
    (call-with-input-file file
       (lambda (p)
         (let f ()
           (let ((x (read-annotated p)))
             (unless (eof-object? x) 
               (proc x)
               (f)))))))
  (let-values (((code* subst env) (make-init-code)))
    (for-each
      (lambda (file)
        (display "expanding ")
        (display file)
        (newline)
        (flush-output-port (current-output-port))
        (load (string-append source-root file)
          (lambda (x)
            (let-values (((name code export-subst export-env)
                          (boot-library-expand x)))
               (set! code* (cons code code*))
               (set! subst (append export-subst subst))
               (set! env (append export-env env))))))
      files)
    (let-values (((export-subst export-env export-locs)
                  (make-system-data (prune-subst subst env) env)))
      (let ((code (build-system-library export-subst export-env export-locs)))
        (values
          (reverse (cons* (car code*) code (cdr code*)))
          export-locs)))))

(define bootstrap-collection
  (let ((ls '()))
    (case-lambda
      (() ls)
      ((x) 
       (unless (memq x ls) 
         (set! ls (cons x ls)))))))

(verify-map)
(library-path '("." "lib/"))

(let ((all-names (map car identifier->library-map))
      (all-labels (map (lambda (x) (gensym)) identifier->library-map))
      (all-bindings (map (lambda (x) 
                           (cond
                             ((macro-identifier x) => cadr)
                             (else `(core-prim . ,x))))
                         (map car identifier->library-map))))
  (let ((export-subst (map cons all-names all-labels))
        (export-env (map cons all-labels all-bindings)))
    (define (build-library legend-entry)
      (let ((key (car legend-entry))
            (name (cadr legend-entry))
            (visible? (caddr legend-entry))
            (required? (cadddr legend-entry)))
        (when required?
          (let ((id     (gensym))
                (name       name)
                (version     (if (eq? (car name) 'rnrs) '(6) '()))
                (import-libs '())
                (visit-libs  '())
                (invoke-libs '()))
            (let-values (((subst env)
                          (if (equal? name '(boot system all))
                              (values export-subst export-env)
                              (values
                                (get-export-subset key export-subst)
                                '()))))
              (parameterize ((current-library-collection 
                              bootstrap-collection))
                (install-library
                   id name version import-libs visit-libs invoke-libs
                   subst env values values #f #f #f '() visible? #f)))))))
    (for-each build-library library-legend)))


(let ()
  (define-syntax define-prims
    (syntax-rules ()
      ((_ name* ...)
       (let ((g* (map gensym '(name* ...)))
             (v* (list name* ...)))
         (for-each set-symbol-value! g* v*)
         (let ((ht (make-eq-hashtable)))
            (for-each 
              (lambda (k v) 
                (hashtable-set! ht k v))              
              '(name* ...) g*)
            (current-primitive-locations
             (lambda (x)
               ;; clr-*-internal 在 stage0 中是特殊形式（没有值），保持裸符号
               (if (memq x '(clr-call-internal clr-cast-internal))
                   #f
                   (let ((op (hashtable-ref ht x #f)))
                     (unless op
                      (error #f "undefined prim" x))
                     op)))))))))
  (define-prims
    zero? string-length vector-ref syntax-violation vector-length cons* cadr cddr filter
    syntax-dispatch apply cons append map list syntax-error reverse format not make-compile-time-value
    assertion-violation null? car cdr pair? bound-identifier=? list->vector
    generate-temporaries = + datum->syntax string->symbol void
    string-append symbol->string syntax->datum gensym length 
    open-string-output-port identifier? free-identifier=? exists
    values call-with-values for-all ellipsis-map vector eq? eqv?))

;;; ---------------------------------------------------------------------------
;;; 种子写出（iron-015）：把核心形式写成 ASCII 文本，供 stage0（iron-016）用新 reader 读回。
;;; 不用宿主的 write：符号、字符串、字符、数值都按新 reader 能读回同一值的写法输出。
;;; - 符号：不合 R6RS 标识符语法的字符写成 \xHH; 转义（新 reader 不支持 |...|）。
;;; - gensym：名字为 g$名字$计数$TICKS，TICKS 随进程变化；改写为 g$名字$计数$%seed，
;;;   计数在同一输入下确定，因此两次生成的种子相同（iron-014）。
;;; - flonum：number->string 后检查能读回同一值；-0.0 单独处理（旧打印器把它写成 0.0）。
;;; - 其他对象（记录、语法对象等）报错。
;;; 布局：放得进 seed-line-width 的子表写在一行，否则头部之后各元素换行缩进 2 格。
;;; ---------------------------------------------------------------------------

(define seed-line-width 100)

(define gensym-ticks
  ;; 本进程 gensym 名字的后缀（最后一个 $ 及其后的部分）
  (let* ((s (symbol->string (gensym)))
         (n (string-length s)))
    (let f ((i (- n 1)))
      (if (char=? (string-ref s i) #\$)
          (substring s i n)
          (f (- i 1))))))

(define (seed-symbol-name sym)
  (let* ((s (symbol->string sym))
         (n (string-length s))
         (k (string-length gensym-ticks)))
    (if (and (> n (+ k 2))
             (char=? (string-ref s 0) #\g)
             (char=? (string-ref s 1) #\$)
             (string=? (substring s (- n k) n) gensym-ticks))
        (string-append (substring s 0 (- n k)) "$%seed")
        s)))

(define (ascii-initial? c)
  (or (char<=? #\a c #\z) (char<=? #\A c #\Z)
      (memv c '(#\! #\$ #\% #\* #\/ #\: #\< #\= #\> #\? #\~ #\_ #\^ #\&))))

(define (ascii-subsequent? c)
  (or (ascii-initial? c) (char<=? #\0 c #\9) (memv c '(#\. #\+ #\@ #\-))))

(define (hex-escape c)
  (string-append "\\x" (number->string (char->integer c) 16) ";"))

(define (symbol->seed-text sym)
  (let* ((s (seed-symbol-name sym))
         (n (string-length s)))
    (cond
      ((member s '("+" "-" "...")) s)
      ((= n 0) (error 'seed "empty symbol"))
      (else
       (let f ((i 0) (acc '()))
         (if (= i n)
             (apply string-append (reverse acc))
             (let ((c (string-ref s i)))
               (f (+ i 1)
                  (cons
                    (cond
                      ((and (= i 0) (char=? c #\-) (> n 1) (char=? (string-ref s 1) #\>)) "-")
                      ((and (= i 1) (char=? c #\>) (char=? (string-ref s 0) #\-)) ">")
                      ((if (= i 0) (ascii-initial? c) (ascii-subsequent? c)) (string c))
                      (else (hex-escape c)))
                    acc)))))))))

;; 字符串按 UTF-16 存储，string-ref 可能得到代理项：成对的代理项合成一个码点再转义。
(define (high-surrogate? k) (<= #xD800 k #xDBFF))
(define (low-surrogate? k) (<= #xDC00 k #xDFFF))

(define (string->seed-text s)
  (let ((n (string-length s)))
    (let f ((i 0) (acc '("\"")))
      (if (= i n)
          (apply string-append (reverse (cons "\"" acc)))
          (let* ((c (string-ref s i))
                 (k (char->integer c)))
            (if (and (high-surrogate? k) (< (+ i 1) n) (low-surrogate? (char->integer (string-ref s (+ i 1)))))
                (let ((cp (+ #x10000 (* (- k #xD800) #x400) (- (char->integer (string-ref s (+ i 1))) #xDC00))))
                  (f (+ i 2) (cons (string-append "\\x" (number->string cp 16) ";") acc)))
                (f (+ i 1)
                   (cons
                     (cond
                       ((char=? c #\") "\\\"")
                       ((char=? c #\\) "\\\\")
                       ((char<=? #\space c #\~) (string c))
                       ((or (high-surrogate? k) (low-surrogate? k)) (error 'seed "unpaired surrogate in string" s))
                       (else (hex-escape c)))
                     acc))))))))

(define (char->seed-text c)
  (if (char<=? #\! c #\~)
      (string #\# #\\ c)
      (string-append "#\\x" (number->string (char->integer c) 16))))

(define (number->seed-text x)
  (cond
    ((and (exact? x) (rational? x)) (number->string x))
    ((flonum? x)
     (cond
       ((flnan? x) "+nan.0")
       ((and (flzero? x) (fl<? (fl/ 1.0 x) 0.0)) "-0.0")
       (else
        (let ((s (number->string x)))
          (unless (eqv? (string->number s) x)
            (error 'seed "flonum does not round-trip" x s))
          s))))
    (else (error 'seed "unsupported number in seed" x))))

(define (atom->seed-text x)
  (cond
    ((symbol? x) (symbol->seed-text x))
    ((null? x) "()")
    ((eq? x #t) "#t")
    ((eq? x #f) "#f")
    ((string? x) (string->seed-text x))
    ((char? x) (char->seed-text x))
    ((number? x) (number->seed-text x))
    (else (error 'seed "unsupported object in seed" x))))

;; 剩余宽度预算内能否写成一行：能则返回剩余预算，否则 #f
(define (fits? x budget)
  (cond
    ((not budget) #f)
    ((< budget 0) #f)
    ((pair? x)
     (let f ((x x) (budget (- budget 2)))
       (cond
         ((not budget) #f)
         ((null? x) budget)
         ((pair? x) (f (cdr x) (fits? (car x) (- budget 1))))
         (else (fits? x (- budget 3))))))
    ((vector? x) (fits? (vector->list x) (- budget 1)))
    ((bytevector? x)
     (let ((r (- budget 5 (* 4 (bytevector-length x)))))
       (and (>= r 0) r)))
    (else
     (let ((r (- budget (string-length (atom->seed-text x)))))
       (and (>= r 0) r)))))

(define (write-seed-flat x p)
  (cond
    ((pair? x)
     (put-char p #\()
     (let f ((x x) (first? #t))
       (cond
         ((null? x) (put-char p #\)))
         ((pair? x)
          (unless first? (put-char p #\space))
          (write-seed-flat (car x) p)
          (f (cdr x) #f))
         (else
          (put-string p " . ")
          (write-seed-flat x p)
          (put-char p #\))))))
    ((vector? x)
     (put-char p #\#)
     (if (= (vector-length x) 0)
         (put-string p "()")
         (write-seed-flat (vector->list x) p)))
    ((bytevector? x)
     (put-string p "#vu8(")
     (let ((n (bytevector-length x)))
       (do ((i 0 (+ i 1))) ((= i n))
         (unless (= i 0) (put-char p #\space))
         (put-string p (number->string (bytevector-u8-ref x i)))))
     (put-char p #\)))
    (else (put-string p (atom->seed-text x)))))

(define (write-seed x indent p)
  (if (or (not (pair? x)) (not (list? x)) (eq? (car x) 'quote) (fits? x (- seed-line-width indent)))
      (write-seed-flat x p)
      (let ((indent (+ indent 2)))
        (put-char p #\()
        (write-seed-flat (car x) p)
        (for-each
          (lambda (e)
            (put-char p #\newline)
            (put-string p (make-string indent #\space))
            (write-seed e indent p))
          (cdr x))
        (put-char p #\)))))

(define (write-seed-file filename forms)
  (when (file-exists? filename) (delete-file filename))
  (call-with-port (open-file-output-port filename (file-options no-fail) (buffer-mode block) (native-transcoder))
    (lambda (p)
      (put-string p ";;; boot-seed.core: core forms of the boot sources after macro expansion (Lcore, designs/03-compiler.md 2).\n")
      (put-string p ";;; Generated by seed-buildscript.sps -- do not edit.\n")
      (for-each
        (lambda (x)
          (put-char p #\newline)
          (write-seed x 0 p)
          (put-char p #\newline))
        forms))))

;; 种子构建：只展开，不编译（designs/05-bootstrap.md §5），结果写成 boot-seed.core；
;; 另把无 Scheme 定义的 core-prim（应由 IronScheme.Core 的 C# 原语或 stage0 提供）列到标准错误。
(let-values (((core* locs)
               (time-it "macro expansion"
                 (lambda ()
                   (parameterize ((current-library-collection bootstrap-collection))
                     (expand-all scheme-library-files))))))
  (display "expanded forms: ")
  (display (length core*))
  (newline)
  (current-primitive-locations
    (lambda (x)
      (cond
        ((assq x locs) => cdr)
        (else #f))))
  (time-it "seed writing"
    (lambda ()
      (write-seed-file (string-append output-root "boot/boot-seed.core")
                       (map compile-core-expr core*))))
  (let ((p (current-error-port)))
    (display "core-prims without Scheme definitions:" p)
    (for-each
      (lambda (x)
        (let ((name (car x)))
          (unless (or (assq name locs) (macro-identifier name))
            (display " " p)
            (display name p))))
      identifier->library-map)
    (newline p)))
