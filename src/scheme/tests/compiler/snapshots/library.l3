(library (snapshot lib)
  ((u g$u (host-using "System.Text"))
   (len g$len
        (lambda "len"
          ()
          (clause
            (l)
            #f
            (if (primcall null? l)
              '0
              (primcall $fx+ '1 (call (mref len) (primcall cdr l)))))))
   (sum g$sum
        (lambda "sum"
          ()
          (clause
            (l acc)
            #f
            (if (primcall null? l)
              acc
              (call
                (mref sum)
                (primcall cdr l)
                (primcall $fx+ acc (primcall car l)))))))
   (sb g$sb
       (lambda "sb"
         ()
         (clause
           (s)
           #f
           (host-call
             "StringBuilder"
             "ToString"
             #f
             (host-new "StringBuilder" s)))))
   (safe
     g$safe
     (lambda "safe"
       ()
       (clause
         (th)
         #f
         (try-finally (call th) (call (gref g$cleanup))))))
   (table g$table (primcall cons 'a '#(1 "x" 2.5))))
  (begin (call (mref len) '(1 2 3)) (call (mref sum) '(1 2) '0)))
