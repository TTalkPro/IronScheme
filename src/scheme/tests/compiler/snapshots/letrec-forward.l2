(lambda #f
  (clause
    (n)
    #f
    (begin
      (set! n (box n))
      (let ((total (box (primcall $uninitialized))))
        (letrec ((f (lambda "f" (clause (x) #f (call g x))))
                 (g (lambda "g"
                      (clause
                        (y)
                        #f
                        (if (primcall null? y)
                          (primcall
                            $check-initialized
                            (unbox total)
                            'total)
                          (call f (primcall cdr y)))))))
          (begin
            (set-box! total (primcall $fx+ (unbox n) '1))
            (letrec ((bump
                       (lambda "bump"
                         (clause
                           ()
                           #f
                           (begin
                             (set-box! n (primcall $fx+ (unbox n) '1))
                             (unbox n))))))
              (begin (call bump) (call f '(1 2))))))))))
