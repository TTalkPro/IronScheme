;;; iron-026 验收：小程序端到端 —— 展开器展开得到 Lcore → 新编译器生成 Lcil → 发射器（内存模式）→ 运行，结果与期望一致。
(import (rnrs) (rnrs eval) (ironscheme) (ironscheme compiler))

(define env (environment '(rnrs) '(rnrs mutable-pairs) '(rnrs mutable-strings) '(ironscheme) '(ironscheme clr)))

(define (run expr)
  ((compile-core (expand->core expr env))))

(define tests
  '(((+ 1 2) . 3)
    ((let loop ((i 0) (acc 0)) (if (= i 1000000) acc (loop (+ i 1) (+ acc 1)))) . 1000000)
    ((letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1))))) (od? (lambda (n) (if (= n 0) #f (ev? (- n 1)))))) (ev? 100001)) . #f)
    ((let () (define (f x) (* x x)) (define y (f 4)) (define (g) (+ y (f 2))) (g)) . 20)
    ((let ((n 0)) (define (inc!) (set! n (+ n 1)) n) (inc!) (inc!) (inc!)) . 3)
    ((let ((f (case-lambda ((a) (list 'one a)) ((a b) (list 'two a b)) ((a . r) (list 'many a r))))) (list (f 1) (f 1 2) (f 1 2 3))) . ((one 1) (two 1 2) (many 1 (2 3))))
    (((lambda args args) 1 2 3 4 5 6) . (1 2 3 4 5 6))
    (((lambda (a b c d e f) (list f e d c b a)) 1 2 3 4 5 6) . (6 5 4 3 2 1))
    ((apply + 1 2 '(3 4)) . 10)
    ((let loop ((n 300000)) (if (= n 0) 'done (apply loop (list (- n 1))))) . done)
    ((call/cc (lambda (k) (dynamic-wind (lambda () #f) (lambda () (k 'escaped)) (lambda () #f)))) . escaped)
    ((let ((log '())) (dynamic-wind (lambda () (set! log (cons 'in log))) (lambda () 'body) (lambda () (set! log (cons 'out log)))) log) . (out in))
    ((guard (e ((symbol? e) (list 'caught e))) (raise 'oops)) . (caught oops))
    ((guard (e ((assertion-violation? e) (condition-message e))) (car 5)) . "not a pair")
    ((call-with-values (lambda () (values 1 2 3)) list) . (1 2 3))
    ((let-values (((q r) (div-and-mod 17 5))) (list q r)) . (3 2))
    ((let () (define-record-type pt (fields x (mutable y))) (let ((p (make-pt 1 2))) (pt-y-set! p 5) (list (pt? p) (pt-x p) (pt-y p)))) . (#t 1 5))
    ((let-syntax ((swap! (syntax-rules () ((_ a b) (let ((t a)) (set! a b) (set! b t)))))) (let ((x 1) (y 2)) (swap! x y) (list x y))) . (2 1))
    ((let loop ((n 10000)) (if (= n 0) 0 (+ 1 (loop (- n 1))))) . 10000)
    ((string-append "ab" (number->string 42) (symbol->string 'cd)) . "ab42cd")
    ((let ((v (make-vector 3 0))) (vector-set! v 1 'x) (vector->list v)) . (0 x 0))
    ((let ((h (make-eq-hashtable))) (hashtable-set! h 'a 1) (hashtable-ref h 'a #f)) . 1)
    ((call-with-string-output-port (lambda (p) (write '(1 "two" #\3) p))) . "(1 \"two\" #\\3)")
    ((map (lambda (x) (* x x)) '(1 2 3)) . (1 4 9))
    ((assq 'b '((a 1) (b 2))) . (b 2))
    ((list (fx+ 1 2) (fx<? 1 2) (fxzero? 0) (eq? 'a 'a) (null? '()) (pair? '(1)) (not #f)) . (3 #t #t #t #t #t #t))
    ((list (exact->inexact 1/2) (expt 2 70) (exact (floor 2.5))) . (0.5 1180591620717411303424 2))
    ((list (char-upcase #\a) (string-ref "λx" 0) (string->symbol "s")) . (#\A #\λ s))
    ((clr-static-call System.Math Max 3 7) . 7)
    ((clr-call System.String ToUpper "abc") . "ABC")
    ((let ((p (cons 1 2))) (set-car! p 10) (car p)) . 10)
    ((let ((s (make-string 2 #\a))) (string-set! s 0 #\b) s) . "ba")
    ((vector-map (lambda (x) (+ x 1)) '#(1 2)) . #(2 3))
    ((list-sort < '(3 1 2)) . (1 2 3))
    ((let ((x 'outer)) (let ((f (lambda () x))) (let ((x 'inner)) (f)))) . outer)
    ((if (and (= 1 1) (or #f 2)) 'yes 'no) . yes)
    ((let loop ((i 0)) (cond ((= i 5) 'five) (else (loop (+ i 1))))) . five)
    ((do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 3) acc)) . (2 1 0))
    ((with-exception-handler (lambda (c) 42) (lambda () (+ 1 (raise-continuable 'c)))) . 43)
    ((guard (e ((assertion-violation? e) 'caught)) (letrec ((x y) (y x)) 'not-detected)) . caught)
    ;; 前向变量拆开连续的 lambda 段后产生的新前向引用（iron-030 修正）
    ((let ()
       (define v (list (lambda () (s2))))
       (define (g) (mc))
       (define (s2) 's2)
       (define (mc) 'mc)
       (list (g) ((car v)))) . (mc s2))))

(define failures 0)
(for-each
  (lambda (t)
    (let ((got (guard (e (#t (list 'exception (if (message-condition? e) (condition-message e) e))))
                 (run (car t)))))
      (unless (equal? got (cdr t))
        (set! failures (+ failures 1))
        (display "FAIL: ") (write (car t)) (newline)
        (display "  expected: ") (write (cdr t)) (newline)
        (display "  got:      ") (write got) (newline))))
  tests)
(display "compile-small: ")
(display (- (length tests) failures))
(display " of ")
(display (length tests))
(display " passed")
(newline)
(unless (= failures 0) (exit 1))
