<Project Sdk="Microsoft.NET.Sdk">
  <!-- 嵌入 API（iron-039）：C# 程序初始化 IronScheme、求值、调用 Scheme 过程。设计：designs/07-tooling-and-embedding.md §5 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronScheme.Hosting</RootNamespace>
    <AssemblyName>IronScheme.Hosting</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IronScheme.Core\IronScheme.Core.csproj" />
    <!-- 编译器在运行时按名字加载发射器（eval、compile-library） -->
    <ProjectReference Include="..\IronScheme.Emit\IronScheme.Emit.csproj" />
    <!-- 只为构建顺序：生成 boot 镜像要先有 stage0（不引用其程序集） -->
    <ProjectReference Include="..\IronScheme.Stage0\IronScheme.Stage0.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    boot 镜像（designs/05-bootstrap.md §3）：stage0 执行文本种子，运行 boot/ironscheme-buildscript-nano.sps，
    用新编译器编译出 src/scheme/boot/ironscheme.boot.{lcil,dll}。在复制输出之前生成，作为内容项复制到本项目
    以及所有引用本项目的项目（宿主、示例）的输出目录，作为默认的 ironscheme.boot.dll。
    按输入增量：种子、构建脚本、boot 源码、lib/ironscheme（编译器及构建脚本导入的库）、nanopass、原语表，
    以及 Core / Emit / Stage0 程序集都没变时跳过（生成一次约 45 秒）。
    dotnet build -p:BuildBootImage=false 只编译 C#。输出到其他目录（自举比对）用 tools/build.cs stage1 <目录>。
  -->
  <PropertyGroup>
    <BuildBootImage Condition="'$(BuildBootImage)' == ''">true</BuildBootImage>
    <SchemeDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\scheme'))</SchemeDir>
    <BootImageDir>$(SchemeDir)\boot</BootImageDir>
    <BootImage>$(BootImageDir)\ironscheme.boot.dll</BootImage>
    <Stage0Dir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\IronScheme.Stage0\bin\$(Configuration)\$(TargetFramework)'))</Stage0Dir>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotnetHost>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DotnetHost>
  </PropertyGroup>

  <ItemGroup>
    <BootImageInput Include="$(SchemeDir)\boot\boot-seed.core;$(SchemeDir)\boot\ironscheme-buildscript-nano.sps;$(SchemeDir)\boot\primitives.ss" />
    <BootImageInput Include="$(SchemeDir)\boot\**\*.sls" />
    <BootImageInput Include="$(SchemeDir)\lib\ironscheme\**\*.sls;$(SchemeDir)\lib\ironscheme\**\*.ss" />
    <BootImageInput Include="$(SchemeDir)\lib\nanopass-framework-scheme\nanopass\**\*.ss;$(SchemeDir)\lib\nanopass-framework-scheme\nanopass\**\*.sls;$(SchemeDir)\lib\nanopass-framework-scheme\nanopass.ss" />
    <BootImageInput Include="$(Stage0Dir)\stage0.dll;$(Stage0Dir)\IronScheme.Core.dll;$(Stage0Dir)\IronScheme.Emit.dll" />
  </ItemGroup>

  <!-- 运行时文件：boot 镜像与 lib/ironscheme（(ironscheme clr) 等不在 boot 中的系统库源码），随引用传递到应用的输出目录 -->
  <ItemGroup>
    <None Include="$(BootImage)" Link="ironscheme.boot.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(SchemeDir)\lib\ironscheme\**\*" Link="lib\ironscheme\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateBootImage" BeforeTargets="CopyFilesToOutputDirectory;GetCopyToOutputDirectoryItems" Condition="'$(BuildBootImage)' == 'true'"
          Inputs="@(BootImageInput)" Outputs="$(BootImage)">
    <Message Importance="high" Text="IronScheme: generating boot image with stage0 (about 45 seconds) -> $(BootImage)" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(Stage0Dir)\stage0.dll&quot; -I lib -I lib/nanopass-framework-scheme boot/boot-seed.core boot/ironscheme-buildscript-nano.sps &quot;$(BootImageDir)&quot;"
          WorkingDirectory="$(SchemeDir)" />
  </Target>
</Project>
